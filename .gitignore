# ====================================================================
# Java / Maven 项目 .gitignore 配置
# ====================================================================

# Maven 构建目录
target/
!.mvn/wrapper/maven-wrapper.jar

# IDE 相关文件
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo

# Eclipse
.classpath
.project
.settings/

# Lombok 生成的文件
*.class

# 日志文件
logs/
*.log
*.log.*

# 操作系统文件
.DS_Store
Thumbs.db

# 临时文件
*.tmp
*.bak
*.swp
*~

# 环境配置文件（包含敏感信息）
# 注意：application-prod.yml 自 P0 修复后只含日志级别、无任何密钥，应当入库，
#      因此不再忽略；密钥一律走环境变量（见 docs/security/SECURITY_SETUP.md）
application-local.yml

# 编译器/工具临时产物
javac.*.args
tmpclaude-*

# 数据库文件
*.db
*.sqlite
