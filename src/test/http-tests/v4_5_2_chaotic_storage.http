### WMS V4.5.2 Flexible Chaotic Storage Regression
### Focus: anti-mixing, location-visual outbound, fragment-first allocation, location self-healing.

@host = http://127.0.0.1:8080
@supplierId = 1
@spuId = 1

### 1. Login
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password123"
}

> {%
client.assert(response.status === 200, "login should succeed");
client.global.set("token", response.body.token);
%}

### 2. Create warehouse
# @name createWarehouse
POST {{host}}/api/warehouses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CH{{$timestamp}}",
  "name": "V4.5.2 Chaotic Storage Warehouse",
  "address": "V4.5.2 regression",
  "contact": "Codex",
  "phone": "13800138045"
}

> {%
client.assert(response.status === 201, "warehouse should be created");
client.global.set("warehouseId", response.body.id);
%}

### 3. Create fragment location
# @name createFragmentLocation
POST {{host}}/api/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "warehouseId": {{warehouseId}},
  "zone": "ZONE_A",
  "shelfNumber": "A",
  "positionNumber": "01",
  "remark": "V4.5.2 fragment-first location"
}

> {%
client.assert(response.status === 201, "fragment location should be created");
client.global.set("fragmentLocationId", response.body.id);
client.global.set("fragmentLocationCode", response.body.locationCode);
%}

### 4. Create bulk location
# @name createBulkLocation
POST {{host}}/api/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "warehouseId": {{warehouseId}},
  "zone": "ZONE_B",
  "shelfNumber": "B",
  "positionNumber": "01",
  "remark": "V4.5.2 bulk location"
}

> {%
client.assert(response.status === 201, "bulk location should be created");
client.global.set("bulkLocationId", response.body.id);
%}

### 5. Create LOCATION_VISUAL product
# @name createVisualProduct
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "barcode": "V452-VIS-{{$timestamp}}",
  "name": "V4.5.2 Location Visual Tea",
  "skuName": "V452-VIS-SKU",
  "spuId": {{spuId}},
  "specs": "chaotic-storage-regression",
  "unitPrice": 10.00,
  "minSalesPrice": 1.00,
  "perPackQty": 1,
  "conversionRate": 1,
  "packUnit": "box",
  "nearExpiryDays": 30,
  "category": "test",
  "batchTrackingMode": "LOCATION_VISUAL",
  "enabled": true
}

> {%
client.assert(response.status === 201, "visual product should be created");
client.assert(response.body.batchTrackingMode === "LOCATION_VISUAL", "product should use LOCATION_VISUAL");
client.global.set("visualProductId", response.body.id);
client.global.set("visualSkuCode", response.body.barcode);
%}

