### 7. Create LOCATION_VISUAL Product (SPU)
# @name createVisualProduct
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productCode": "V452-VIS-SPU-{{runId}}",
  "productName": "V4.5.2 Location Visual Tea",
  "categoryId": {{categoryId}},
  "brand": "Codex",
  "description": "chaotic-storage-regression",
  "enabled": true
}

> {%
client.assert(response.status === 201, "visual Product should be created");
client.global.set("visualProductId", response.body.id);
%}

### 8. Create LOCATION_VISUAL ProductSku
# @name createVisualProductSku
POST {{host}}/api/product-skus
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": {{visualProductId}},
  "barcode": "V452-VIS-{{runId}}",
  "name": "V4.5.2 Location Visual Tea",
  "skuName": "V452-VIS-SKU",
  "specs": "chaotic-storage-regression",
  "unitPrice": 10.00,
  "minSalesPrice": 1.00,
  "perPackQty": 1,
  "conversionRate": 1,
  "packUnit": "box",
  "nearExpiryDays": 30,
  "batchTrackingMode": "LOCATION_VISUAL",
  "enabled": true
}

> {%
client.assert(response.status === 201, "visual ProductSku should be created");
client.assert(response.body.batchTrackingMode === "LOCATION_VISUAL", "ProductSku should use LOCATION_VISUAL");
client.global.set("visualProductSkuId", response.body.id);
client.global.set("visualSkuCode", response.body.skuCode);
%}

