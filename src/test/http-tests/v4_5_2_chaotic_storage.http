POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "barcode": "V452-MIX-{{$timestamp}}",
  "name": "V4.5.2 Mixing Attack Product",
  "skuName": "V452-MIX-SKU",
  "spuId": {{spuId}},
  "specs": "chaotic-storage-negative-case",
  "unitPrice": 10.00,
  "minSalesPrice": 1.00,
  "perPackQty": 1,
  "conversionRate": 1,
  "packUnit": "box",
  "nearExpiryDays": 30,
  "category": "test",
  "batchTrackingMode": "LOCATION_VISUAL",
  "enabled": true
}

> {%
client.assert(response.status === 201, "mixing attack product should be created");
client.global.set("mixingProductId", response.body.id);
%}

### 7. Create customer
# @name createCustomer
POST {{host}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CUST-V452-{{$timestamp}}",
  "name": "V4.5.2 Test Customer",
  "contact": "Codex",
  "phone": "13800138045",
