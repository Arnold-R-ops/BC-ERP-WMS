### WMS V4.5 Enterprise Hardening Suite
### Covers: idempotency, security, data integrity, dirty input.
### True concurrent stock race test:
###   powershell -ExecutionPolicy Bypass -File src/test/scripts/run-v45-hardening.ps1

@host = http://127.0.0.1:8080
@supplierId = 1
@runId = {{$timestamp}}

### 1. Login
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password123"
}

> {%
client.assert(response.status === 200, "admin login should succeed");
client.assert(!!response.body.token, "login should return JWT token");
client.global.set("token", response.body.token);
%}

### 2. Create warehouse for hardening data
# @name createHardeningWarehouse
POST {{host}}/api/warehouses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "HH{{runId}}",
  "name": "V4.5 Hardening Warehouse",
  "address": "hardening regression",
  "contact": "Codex",
  "phone": "13800138045"
}

> {%
client.assert(response.status === 201, "warehouse should be created");
client.assert(response.body.companyId === 1, "warehouse companyId should default to 1");
client.global.set("warehouseId", response.body.id);
client.global.set("warehouseCode", response.body.code);
%}

### 3. Same-company duplicate warehouse code must be rejected
# @name duplicateWarehouseCode
POST {{host}}/api/warehouses
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "{{warehouseCode}}",
  "name": "Duplicate Warehouse",
  "address": "hardening regression",
  "contact": "Codex",
  "phone": "13800138045"
}

> {%
client.assert(response.status === 409, "duplicate warehouse code should be rejected");
client.assert(response.body.errorKey === "WAREHOUSE_ALREADY_EXISTS", "duplicate warehouse should return WAREHOUSE_ALREADY_EXISTS");
%}

### 4. Create stock location
# @name createHardeningLocation
POST {{host}}/api/locations
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "warehouseId": {{warehouseId}},
  "zone": "ZONE_A",
  "shelfNumber": "A",
  "positionNumber": "01",
  "remark": "hardening stock location"
}

> {%
client.assert(response.status === 201, "location should be created");
client.global.set("locationId", response.body.id);
%}

### 5. Create isolated category tree
# @name createHardeningRootCategory
POST {{host}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryCode": "HARD_ROOT_{{runId}}",
  "categoryName": "V4.5 Hardening Root {{runId}}",
  "sortOrder": 100
}

> {%
client.assert(response.status === 201, "root category should be created");
client.global.set("rootCategoryId", response.body.id);
%}

### 6. Create leaf category
# @name createHardeningLeafCategory
POST {{host}}/api/categories
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoryCode": "HARD_LEAF_{{runId}}",
  "categoryName": "V4.5 Hardening Leaf {{runId}}",
  "parentId": {{rootCategoryId}},
  "sortOrder": 100
}

> {%
client.assert(response.status === 201, "leaf category should be created");
client.global.set("categoryId", response.body.id);
%}

### 7. Create Product (SPU)
# @name createHardeningProduct
POST {{host}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productCode": "HARD-SPU-{{runId}}",
  "productName": "V4.5 Hardening Product",
  "categoryId": {{categoryId}},
  "brand": "Codex",
  "description": "hardening regression",
  "enabled": true
}

> {%
client.assert(response.status === 201, "Product should be created");
client.global.set("productId", response.body.id);
%}

### 8. Create ProductSku that requires manual approval because test order price is below minSalesPrice
# @name createHardeningProductSku
POST {{host}}/api/product-skus
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": {{productId}},
  "barcode": "HARD-PROD-{{runId}}",
  "name": "V4.5 Hardening Product",
  "skuName": "HARD-SKU",
  "specs": "hardening regression",
  "unitPrice": 10.00,
  "minSalesPrice": 10.00,
  "perPackQty": 1,
  "conversionRate": 1,
  "packUnit": "box",
  "nearExpiryDays": 30,
  "batchTrackingMode": "PRINTED_LABEL",
  "enabled": true
}

> {%
client.assert(response.status === 201, "ProductSku should be created");
client.global.set("productSkuId", response.body.id);
client.global.set("productSkuBarcode", response.body.barcode);
%}

### 9. Same-company duplicate SKU barcode must be rejected
# @name duplicateProductSkuBarcode
POST {{host}}/api/product-skus
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productId": {{productId}},
  "barcode": "{{productSkuBarcode}}",
  "name": "Duplicate Hardening Product",
  "skuName": "DUP-HARD-SKU",
  "specs": "duplicate barcode",
  "unitPrice": 10.00,
  "minSalesPrice": 1.00,
  "perPackQty": 1,
  "conversionRate": 1,
  "packUnit": "box",
  "nearExpiryDays": 30,
  "enabled": true
}

> {%
client.assert(response.status === 409, "duplicate SKU barcode should be rejected");
client.assert(response.body.errorKey === "PRODUCT_SKU_ALREADY_EXISTS", "duplicate SKU should return PRODUCT_SKU_ALREADY_EXISTS");
%}

### 10. Create customer
# @name createHardeningCustomer
POST {{host}}/api/customers
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "CUST-HARD-{{runId}}",
  "name": "V4.5 Hardening Customer",
  "contact": "Codex",
  "phone": "13800138045",
  "email": "hard{{runId}}@example.com",
  "address": "hardening regression",
  "creditLimit": 100000.00,
  "isActive": true
}

> {%
client.assert(response.status === 201, "customer should be created");
client.global.set("customerId", response.body.id);
%}

### 11. Create inbound stock order
# @name createInboundStock
POST {{host}}/api/inbound-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "supplierId": {{supplierId}},
  "expectedDate": "2026-12-01",
  "remark": "V4.5 hardening stock setup",
  "items": [
    {
      "productSkuId": {{productSkuId}},
      "planQty": 5,
      "unitCost": 5.00,
      "targetWarehouseId": {{warehouseId}},
      "targetLocationId": {{locationId}},
      "remark": "hardening stock"
    }
  ]
}

> {%
client.assert(response.status === 201, "inbound stock order should be created");
client.global.set("inboundOrderId", response.body.id);
client.global.set("inboundItemId", response.body.items[0].id);
%}

### 12. Approve inbound stock order
POST {{host}}/api/inbound-orders/{{inboundOrderId}}/approve-plan
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "hardening approve"
}

> {%
client.assert(response.status === 200, "inbound approval should succeed");
%}

### 13. Confirm inbound stock order
POST {{host}}/api/inbound-orders/{{inboundOrderId}}/confirm-order
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "hardening confirm",
  "confirmations": [
    {
      "itemId": {{inboundItemId}},
      "confirmedQty": 5,
      "expiryDate": "2027-12-31",
      "productionDate": "2026-06-01",
      "targetWarehouseId": {{warehouseId}},
      "targetLocationId": {{locationId}}
    }
  ]
}

> {%
client.assert(response.status === 200, "inbound confirmation should succeed");
%}

### 14. Receive inbound stock order
POST {{host}}/api/inbound-orders/{{inboundOrderId}}/receive-goods
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "receipts": [
    {
      "itemId": {{inboundItemId}},
      "actualQty": 5,
      "locationId": {{locationId}}
    }
  ]
}

> {%
client.assert(response.status === 200, "inbound receiving should succeed");
%}

### 15. Create sales order that requires approval
# @name createApprovalSalesOrder
POST {{host}}/api/sales-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": {{customerId}},
  "items": [
    {
      "productSkuId": {{productSkuId}},
      "quantity": 2,
      "unitPrice": 1.00,
      "rejectNearExpiry": false,
      "remark": "hardening idempotency order"
    }
  ]
}

> {%
client.assert(response.status === 201, "sales order should be created");
client.assert(response.body.status === "PENDING_APPROVAL", "sales order should wait for approval");
client.global.set("salesOrderId", response.body.id);
%}

### 16. First approval should succeed
# @name firstApproveSalesOrder
POST {{host}}/api/sales-orders/{{salesOrderId}}/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "first approve",
  "allocationPolicy": "FULL_ONLY"
}

> {%
client.assert(response.status === 200, "first approval should succeed");
client.assert(response.body.status === "APPROVED_AWAITING_SHIPMENT", "approved order should await shipment");
%}

### 17. Duplicate approval should be rejected as a state-machine conflict
# @name duplicateApproveSalesOrder
POST {{host}}/api/sales-orders/{{salesOrderId}}/approve
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "comment": "duplicate approve",
  "allocationPolicy": "FULL_ONLY"
}

> {%
client.assert(response.status === 409, "duplicate approval should return 409");
client.assert(response.body.errorKey === "SALES_ORDER_INVALID_STATUS", "duplicate approval should return invalid status");
%}

### 18. Query outbound task
# @name listOutboundTasks
GET {{host}}/api/outbound-tasks?salesOrderId={{salesOrderId}}
Authorization: Bearer {{token}}

> {%
client.assert(response.status === 200, "outbound task query should succeed");
client.assert(response.body.length >= 1, "approval should create outbound task");
client.global.set("outboundTaskId", response.body[0].id);
client.global.set("outboundTaskQty", response.body[0].planQty);
%}

### 19. First outbound confirm should succeed
# @name firstConfirmOutbound
POST {{host}}/api/outbound-tasks/{{outboundTaskId}}/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualQty": {{outboundTaskQty}}
}

> {%
client.assert(response.status === 200, "first outbound confirm should succeed");
client.assert(response.body.status === "COMPLETED", "outbound task should be completed");
%}

### 20. Stock after first confirm
# @name stockAfterFirstConfirm
GET {{host}}/api/inventory/total-stock/{{productSkuId}}
Authorization: Bearer {{token}}

> {%
client.assert(response.status === 200, "stock query should succeed after first confirm");
client.global.set("stockAfterFirstConfirm", response.body.totalStock);
%}

### 21. Duplicate outbound confirm should be rejected and must not deduct twice
# @name duplicateConfirmOutbound
POST {{host}}/api/outbound-tasks/{{outboundTaskId}}/confirm
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "actualQty": {{outboundTaskQty}}
}

> {%
client.assert(response.status === 409, "duplicate outbound confirm should return 409");
client.assert(response.body.errorKey === "OUTBOUND_TASK_ALREADY_COMPLETED", "duplicate confirm should return already completed");
%}

### 22. Stock after duplicate confirm should be unchanged
GET {{host}}/api/inventory/total-stock/{{productSkuId}}
Authorization: Bearer {{token}}

> {%
client.assert(response.status === 200, "stock query should succeed after duplicate confirm");
client.assert(
  Number(response.body.totalStock) === Number(client.global.get("stockAfterFirstConfirm")),
  "duplicate confirm must not deduct stock twice"
);
%}

### 23. Security: missing token should be rejected
# @name securityMissingToken
POST {{host}}/api/warehouses
Content-Type: application/json

{
  "code": "NOAUTH{{runId}}",
  "name": "No Auth Warehouse",
  "address": "hardening regression",
  "contact": "Codex",
  "phone": "13800138045"
}

> {%
client.assert(response.status === 401 || response.status === 403, "missing token should be rejected");
%}

### 24. Security: fake token should be rejected
# @name securityFakeToken
POST {{host}}/api/warehouses
Authorization: Bearer fake.invalid.token
Content-Type: application/json

{
  "code": "FAKE{{runId}}",
  "name": "Fake Token Warehouse",
  "address": "hardening regression",
  "contact": "Codex",
  "phone": "13800138045"
}

> {%
client.assert(response.status === 401 || response.status === 403, "fake token should be rejected");
%}

### 25. Boundary: zero sales quantity should be rejected
# @name boundaryZeroSalesQuantity
POST {{host}}/api/sales-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": {{customerId}},
  "items": [
    {
      "productSkuId": {{productSkuId}},
      "quantity": 0,
      "unitPrice": 1.00,
      "rejectNearExpiry": false
    }
  ]
}

> {%
client.assert(response.status === 400, "zero sales quantity should be rejected");
client.assert(response.body.errorKey === "VALIDATION_FAILED", "zero sales quantity should be validation failure");
%}

### 26. Boundary: missing customer should be rejected
# @name boundaryMissingCustomer
POST {{host}}/api/sales-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "items": [
    {
      "productSkuId": {{productSkuId}},
      "quantity": 1,
      "unitPrice": 1.00,
      "rejectNearExpiry": false
    }
  ]
}

> {%
client.assert(response.status === 400, "missing customer should be rejected");
client.assert(response.body.errorKey === "VALIDATION_FAILED", "missing customer should be validation failure");
%}

### 27. Boundary: non-existent SKU should be rejected
# @name boundaryMissingProductSku
POST {{host}}/api/sales-orders
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "customerId": {{customerId}},
  "items": [
    {
      "productSkuId": 999999999,
      "quantity": 1,
      "unitPrice": 1.00,
      "rejectNearExpiry": false
    }
  ]
}

> {%
client.assert(response.status === 404, "non-existent SKU should be rejected");
client.assert(response.body.errorKey === "PRODUCT_SKU_NOT_FOUND", "non-existent SKU should return PRODUCT_SKU_NOT_FOUND");
%}

### 28. Boundary: zero stock adjustment should be rejected
# @name boundaryZeroStockAdjustment
POST {{host}}/api/inventory/adjust
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "productSkuId": {{productSkuId}},
  "locationId": {{locationId}},
  "transactionType": "ADJUST",
  "sourceType": "MANUAL_ADJUST",
  "quantity": 0,
  "sourceOrderId": "HARD-BAD-ADJ-{{runId}}",
  "operatorId": 2,
  "operatorName": "admin",
  "remark": "hardening bad input"
}

> {%
client.assert(response.status === 400, "zero stock adjustment should be rejected");
client.assert(response.body.errorKey === "VALIDATION_FAILED", "zero stock adjustment should be validation failure");
%}
